{
  "name": "rx-ray",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:sync": "node --env-file=.env.local --import tsx scripts/sync-greenbook.ts",
    "db:check": "node --env-file=.env.local --import tsx scripts/check-one.ts"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@lottiefiles/dotlottie-react": "^0.20.0",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.8",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.59.0",
    "motion": "^14.3.0",
    "next": "^16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": true,
    "@google/genai@2.30.0": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.12.2": true
  }
}
