# Copy to .env.local and fill in the values.

# Google Gemini API key used by POST /api/scan to read pack labels.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Path to the SQLite snapshot of NAFDAC's Greenbook.
# Keep this relative to the project root. On Vercel, use the same value so the
# snapshot bundled by outputFileTracingIncludes is found at runtime.
DATABASE_URL="file:./prisma/dev.db"

# Optional: n8n webhook that receives reports for packs whose registration
# number is not in the Greenbook. Leave empty to disable reporting.
# See README > Reporting unregistered packs.
N8N_FLAGGED_WEBHOOK_URL=
